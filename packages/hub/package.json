{
  "name": "@xmatrix/hub",
  "version": "1.0.250",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev-stack.mjs --hub-only",
    "build": "echo 'Hub is deployed via wrangler'",
    "pretest": "pnpm --filter @xmatrix/protocol build",
    "test": "pnpm run test:ci",
    "test:ci": "node ../../scripts/run-with-process-tree.mjs -- node ../../scripts/run-auto-routing-repro.mjs --hub-suite",
    "pretypecheck": "pnpm --filter @xmatrix/protocol build",
    "typecheck": "pnpm run typecheck:ci",
    "typecheck:ci": "tsc --noEmit",
    "message:inspect": "tsx scripts/postgres-message-inspect.ts",
    "test:campaign": "node ../../scripts/run-with-process-tree.mjs -- node test/run-suite.mjs --campaign --test-concurrency=auto --test-timeout=300000",
    "env:doc": "tsx scripts/hub-environment-doc.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@xmatrix/billing": "workspace:*",
    "@xmatrix/db": "workspace:*",
    "@xmatrix/decision-model": "workspace:*",
    "@xmatrix/protocol": "workspace:*",
    "better-auth": "1.6.33",
    "hono": "4.12.18",
    "jose": "6.2.3",
    "lib0": "0.2.118",
    "pg": "8.22.0",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260401.1",
    "@types/pg": "8.20.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "wrangler": "4.79.0"
  }
}
