  {
    "id": "claude",
    "displayName": "Claude Code",
    "description": "Claude Code CLI through the print backend.",
    "runtime": "claude",
    "agentType": "claude_code",
    "avatarUrl": "/agent-vendors/claude.svg",
    "defaultArgs": ["--dangerously-skip-permissions"],
    "backend": "claude-print",
    "launcherNames": ["claude", "claude-code", "claude_code", "claude.exe", "claude.cmd", "claude.bat"],
    "classicConfigDirs": ["~/.claude"],
    "installHint": "curl -fsSL https://claude.ai/install.sh | bash",
    "management": {
      "version": {
        "command": "claude",
        "args": ["--version"],
        "regex": "([0-9]+(?:\\.[0-9]+){1,3}(?:[-+][0-9A-Za-z.-]+)?)"
      },
      "install": {
        "unix": {
          "command": "bash",
          "args": ["-c", "curl -fsSL https://claude.ai/install.sh | bash"]
        },
        "windows": {
          "command": "powershell",
          "args": ["-NoProfile", "-Command", "irm 'https://claude.ai/install.ps1' | iex"]
        }
      },
      "update": {
        "unix": {
          "command": "claude",
          "args": ["update"]
        },
        "windows": {
          "command": "claude",
          "args": ["update"]
        }
      },
      "uninstall": {
        "unix": {
          "command": "bash",
          "args": ["-c", "rm -f ~/.local/bin/claude && rm -rf ~/.local/share/claude"]
        },
        "windows": {
          "command": "powershell",
          "args": ["-NoProfile", "-Command", "Remove-Item -Path \"$env:USERPROFILE\\.local\\bin\\claude.exe\" -Force; Remove-Item -Path \"$env:USERPROFILE\\.local\\share\\claude\" -Recurse -Force"]
        }
      },
      "autoUpdate": {
        "behavior": "automatic",
        "defaultEnabled": true,
        "controls": [
          {
            "kind": "env",
            "key": "DISABLE_AUTOUPDATER",
            "enabled": null,
            "disabled": "1"
          }
        ],
        "disabledBy": [
          { "kind": "env", "key": "DISABLE_UPDATES" },
          { "kind": "env", "key": "DISABLE_AUTOUPDATER", "values": ["1", "true", "yes", "on"] },
          { "kind": "env", "key": "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC" },
          {
            "kind": "json",
            "path": "~/.claude.json",
            "key": "autoUpdates",
            "value": false,
            "unless": { "installMethod": "native", "autoUpdatesProtectedForNative": true }
          }
        ],
        "envFiles": ["~/.claude/settings.json"],
        "interactiveOnly": true,
        "notes": "Native installer updates automatically, but only in interactive sessions: --print (xMatrix's launch mode) never checks. Homebrew/WinGet/apk installations remain package-manager owned. disabledBy mirrors Claude Code 2.1.281's updater gate."
      },
      "latest": { "kind": "npm", "package": "@anthropic-ai/claude-code" },
      "sources": ["https://code.claude.com/docs/en/setup"],
      "checkedAt": "2026-09-30"
    }
  },
