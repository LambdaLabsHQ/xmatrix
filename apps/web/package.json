  "scripts": {
    "dev": "next dev --turbopack",
    "dev:local": "next dev --turbopack -p 3001",
    "prebuild": "pnpm --filter @xmatrix/protocol build",
    "build": "next build",
    "ci:build": "next build",
    "e2e:build": "node e2e/build.mjs",
    "start": "next start",
    "start:local": "next start -p 3001",
    "start:fresh": "pnpm build && next start -p 3001",
    "e2e:dev": "next dev --turbopack -p 4611",
    "test:e2e": "playwright test",
    "test:e2e:ci": "cross-env PLAYWRIGHT_REUSE_SERVER=0 playwright test",
    "lint": "eslint .",
    "pretypecheck": "pnpm --filter @xmatrix/protocol build",
    "typecheck": "tsc --noEmit",
    "prebuild:cloudflare": "pnpm --filter @xmatrix/protocol build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "pnpm build:cloudflare && opennextjs-cloudflare deploy",
    "test:e2e:mock-app": "cross-env PLAYWRIGHT_REUSE_SERVER=0 playwright test --project=mock-app",
    "test:message-attachment-upload": "node --test src/lib/relay-v2/message-attachment-upload-client.test.cjs",
    "pretest": "pnpm --filter @xmatrix/protocol build",
    "test": "node --test",
    "test:ci": "node --test"
  },
