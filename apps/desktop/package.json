{
  "name": "@xmatrix/desktop",
  "version": "1.0.138",
  "description": "xMatrix desktop client for agent workspace chat.",
  "author": "xMatrix",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/*.test.cjs",
    "dev": "pnpm build && cross-env XMATRIX_DESKTOP_DEV_URL=http://localhost:3001/app electron .",
    "start": "electron .",
    "dist": "pnpm build && electron-builder",
    "dist:mac": "pnpm build && electron-builder --mac --arm64",
    "dist:mac:arm64": "pnpm build && electron-builder --mac --arm64",
    "dist:win": "pnpm build && electron-builder --win --x64"
  },
  "build": {
    "appId": "net.madebyrobot.xmatrix",
    "productName": "xMatrix",
    "electronVersion": "41.10.6",
    "asar": true,
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/app-update.yml",
        "to": "app-update.yml"
      },
      {
        "from": "resources/cli",
        "to": "cli",
        "filter": [
          "**/*",
          "!.gitkeep"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://xmatrix.sh/api/desktop/releases/stable"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "timestamp": "none",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "protocols": [
      {
        "name": "xMatrix Links",
        "schemes": [
          "xmatrix"
        ]
      }
    ]
  },
  "dependencies": {
    "@xmatrix/protocol": "workspace:*",
    "electron-updater": "6.8.3"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "cross-env": "10.1.0",
    "electron": "41.10.6",
    "electron-builder": "26.8.1",
    "typescript": "5.9.3"
  }
}
