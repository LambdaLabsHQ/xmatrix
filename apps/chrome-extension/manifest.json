{
  "manifest_version": 3,
  "name": "xMatrix",
  "description": "Your xMatrix Space beside every page: discuss what you are reading with your team and Agents.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open xMatrix",
    "default_icon": {
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "alarms", "contextMenus", "scripting", "sidePanel", "storage"],
  "host_permissions": ["https://xmatrix-hub.xmatrix.sh/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "web_accessible_resources": [
    { "resources": ["app/ask.html", "app/index.html"], "matches": ["https://*/*", "http://*/*"] }
  ],
  "externally_connectable": {
    "matches": [
      "https://xmatrix.sh/*",
      "https://beta.xmatrix.sh/*"
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Open xMatrix beside this page"
    }
  }
}
