{
  "name": "xmatrix",
  "version": "1.0.109",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "jev:evaluate": "pnpm --silent --filter @xmatrix/decision-model evaluate",
    "dev": "turbo dev",
    "dev:stack": "node scripts/dev-stack.mjs",
    "build": "turbo build",
    "ci": "node scripts/ci.mjs",
    "check": "pnpm check:reachability && pnpm check:unused-imports && pnpm check:css-duplicate-rules && pnpm check:duplicates && pnpm check:line-limit",
    "check:reachability": "knip --reporter compact && knip --production --include exports --reporter compact",
    "check:css-duplicate-rules": "node scripts/check-css-duplicate-rules.mjs",
    "check:duplicates": "node scripts/check-duplicates.mjs",
    "e2e:hub-network": "node scripts/hub-network-e2e/run-reconnect-catchup.mjs",
    "repro:auto-routing": "node scripts/run-auto-routing-repro.mjs",
    "lint": "turbo lint",
    "version:check": "node scripts/version.mjs check",
    "version:check-order": "node scripts/version.mjs check-release-order",
    "version:sync": "node scripts/version.mjs sync",
    "version:set": "node scripts/version.mjs set",
    "catalogs:check": "node scripts/refresh-agent-command-catalogs.mjs --check",
    "catalogs:sources": "node scripts/refresh-agent-command-catalogs.mjs --print-sources",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "web:dev": "pnpm --filter @xmatrix/web dev:local",
    "web:start": "pnpm --filter @xmatrix/web start:local",
    "web:start:fresh": "pnpm --filter @xmatrix/web start:fresh",
    "desktop:dev": "concurrently -k -n web,desktop -c cyan,magenta \"pnpm web:dev\" \"wait-on http://localhost:3001/app && pnpm --filter @xmatrix/desktop dev\"",
    "desktop:start": "pnpm --filter @xmatrix/desktop start",
    "desktop:build": "pnpm --filter @xmatrix/desktop build",
    "desktop:build:mac": "pnpm --filter @xmatrix/desktop dist:mac",
    "ios:open": "open apps/ios/xMatrix.xcodeproj",
    "ios:build": "/usr/bin/env -i HOME=\"$HOME\" USER=\"$USER\" PATH=\"/Applications/Xcode.app/Contents/Developer/usr/bin:/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin:/usr/bin:/bin:/usr/sbin:/sbin\" DEVELOPER_DIR=\"/Applications/Xcode.app/Contents/Developer\" xcodebuild -project apps/ios/xMatrix.xcodeproj -scheme xMatrix -configuration Debug -destination 'generic/platform=iOS Simulator' build",
    "ios:testflight": "bash scripts/ios-testflight.sh",
    "android:deploy": "node scripts/android-deploy.mjs",
    "android:bundle-web": "node scripts/android-bundle-web.mjs",
    "android:publish-release": "node scripts/android-publish-github-release.mjs",
    "android:release-assets": "node scripts/android-release-assets.mjs",
    "mock:agent": "pnpm --filter @xmatrix/mock-agent start",
    "check:line-limit": "node scripts/check-line-limit.mjs",
    "check:unused-imports": "node scripts/check-unused-imports.mjs",
    "lint:check": "oxlint --config .oxlintrc.json --deny-warnings .",
    "lint:clippy": "cargo clippy --manifest-path packages/cli-rs/Cargo.toml --workspace --all-targets --locked -- -D warnings"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.984.0",
    "@aws-sdk/lib-storage": "3.984.0",
    "concurrently": "9.2.1",
    "electron-builder": "26.8.1",
    "embedded-postgres": "17.10.0-beta.17",
    "jscpd": "4.1.0",
    "knip": "6.12.2",
    "oxlint": "1.64.0",
    "smol-toml": "1.7.0",
    "turbo": "2.9.18",
    "typescript": "5.9.3",
    "wait-on": "9.0.5",
    "wrangler": "4.79.0",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@11.3.0"
}
